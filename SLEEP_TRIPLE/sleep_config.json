{
  "name": "SLEEP_TRIPLE",
  "version": "2.0.0",
  "purpose": "Five autonomous revenue lanes running 23:00-07:00 AEST. Zero approvals, real AUD, local-first AI.",
  "tz": "Australia/Sydney",
  "sleep_window": [
    "23:00",
    "07:00"
  ],
  "dry_run_default": true,
  "max_daily_aud_spend": 0.0,
  "max_daily_aud_risk": 0.0,
  "autonomous_master": {
    "dry_run_default": false,
    "service_recovery_timeout": 180,
    "preflight_timeout": 60,
    "orchestrator_timeout": 600
