      "instant_approval_affiliate_programs": [
        "https://affiliates.kraken.com",
        "https://www.binance.com/en/activity/referral",
        "https://www.hostinger.com/affiliates",
        "https://crypto.com/affiliates",
        "https://affiliateprogram.withpersona.com/affiliates",
        "https://www.ledger.com/affiliate"
      ]
    },
    "c": {
      "label": "Crypto Yield + Arbitrage (Freqtrade)",
      "enabled": true,
      "snapshot_only": true,
      "exchanges_observed": [
        "coinspot",
        "kraken",
        "independentreserve"
      ],
      "stablecoin_pairs": [
        "USDC/AUD",
        "USDT/AUD"
      ],
      "max_capital_aud": 0,
      "stablecoin_threshold_bps": 50,
      "freqtrade_config": {
        "enabled": false,
        "dry_run": true,
        "exchange": "kraken",
        "stake_currency": "USDC",
        "stake_amount": 500,
        "max_open_trades": 3
      }
    },
    "d": {
      "label": "API-as-a-Service Micro-SaaS (Vercel/Cloudflare)",
      "enabled": false,
      "products_per_week": 1,
      "apis_planned": [
        "youtube_transcript_extractor",
        "comfyui_workflow_validator",
        "n8n_workflow_generator"
      ],
      "deployment": "vercel_free_tier",
      "billing": "stripe_subscriptions"
    },
    "e": {
          "label": "Print-on-Demand AI Design Factory (Shopify/Printful)",
          "enabled": false,
          "products_per_night": 1,
          "default_product_kind": "tshirt",
          "default_niche": "ai_humor",
          "ollama_model_preference": "ornith:9b",
          "comfyui_url": "http://127.0.0.1:8188",
          "shopify_dry_run": true,
          "printful_dry_run": true,
          "shopify_store_url": "",
          "printful_api_key": ""
        },
        "f": {
          "label": "AI Money-Making App Discovery Engine",
          "enabled": true,
          "discovery_frequency": "daily",
          "sources": ["github_awesome", "reddit", "producthunt"],
          "max_per_source": 15,
          "min_weighted_score": 50,
          "generate_build_plans": true,
          "ollama_model_preference": "ornith:9b",
          "openrouter_model_fallback": "qwen/qwen3-next-80b-a3b-instruct:free",
          "analysis_model": "analysis",
          "coding_model": "coding",
          "creative_model": "creative",
          "fast_model": "fast"
        }
      },
  "notes": [
    "Sleep Triple v2 ships with AUD=$0 risk ceiling by default. --run --with-risk flag allows live operations.",
    "Auto-listing to Gumroad stays in --dry-run until --publish flag is set on opt_a_digital_factory.py.",
    "Crypto yield is OBSERVATION-ONLY by default. --execute flag is required for any live trade.",
    "Freqtrade integration available for Lane C - install via pip, configure Kraken API, backtest 90 days, dry-run 2 weeks.",
    "All outputs append to existing REVENUE_LEDGER.jsonl via Append-RevenueEvent.ps1.",
    "Each module is independently skippable: --skip-a, --skip-b, --skip-c, --skip-d, --skip-e.",
    "Lane D (API SaaS) and Lane E (POD) require build-out before enabling.",
    "Models: Primary = Ornith-9B (local Ollama, 69.4% SWE-Bench), Fallback = OpenRouter free models."
  ]
}
