          "context": 128000,
          "costPer1k": 0,
          "speed": "medium",
          "useCase": "code",
          "enabled": true
        },
        {
          "id": "nvidia/nemotron-3-super-120b-a12b:free",
          "name": "Nemotron 3 Super 120B",
          "context": 128000,
          "costPer1k": 0,
