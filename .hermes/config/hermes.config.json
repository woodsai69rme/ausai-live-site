          "enabled": true
        },
        {
          "id": "nvidia/nemotron-nano-9b-v2:free",
          "name": "Nemotron Nano 9B",
          "context": 128000,
          "costPer1k": 0,
          "speed": "fast",
          "useCase": "fast",
          "enabled": true
        },
        {
          "id": "nvidia/nemotron-3.5-lightning:free",
          "name": "Nemotron 3.5 Lightning",
          "context": 1000000,
