          "name": "Liquid LFM 2.6B",
          "context": 32000,
          "costPer1k": 0,
          "speed": "fast",
          "useCase": "fast",
          "enabled": true
        }
      ],
      "routing": {
        "default": "google/gemma-4-26b-a4b-it:free",
        "byTask": {
          "code": "nvidia/nemotron-3-ultra-550b-a55b:free",
          "reasoning": "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free",
          "fast": "nvidia/nemotron-nano-9b-v2:free",
          "creative": "google/gemma-4-26b-a4b-it:free"
        }
      },
      "rateLimits": {
        "requestsPerMinute": 20,
        "requestsPerDay": 200
      }
    },
    "local": {
      "enabled": true,
      "ollama": {
        "baseUrl": "http://localhost:11434",
        "models": [
          {
            "id": "llama3.2",
            "name": "Llama 3.2",
            "size": "3B",
            "useCase": "fast",
            "enabled": true
          },
          {
            "id": "phi3:latest",
            "name": "Phi-3",
            "size": "14B",
            "useCase": "balanced",
            "enabled": true
          },
          {
            "id": "qwen2.5-coder",
            "name": "Qwen 2.5 Coder",
            "size": "7B",
            "useCase": "code",
            "enabled": true
          },
          {
            "id": "gemma2:9b",
            "name": "Gemma 2 9B",
            "size": "9B",
            "useCase": "general",
            "enabled": true
          },
          {
            "id": "mistral",
            "name": "Mistral",
            "size": "7B",
            "useCase": "general",
            "enabled": true
          },
          {
            "id": "nomic-embed-text",
            "name": "Nomic Embed Text",
            "size": "1.5B",
            "useCase": "embeddings",
            "enabled": true
          }
        ],
        "autoDownload": true
      }
    }
  },
  "features": {
    "mcp": {
      "enabled": true,
      "servers": [
        "filesystem",
        "web-search",
        "github",
        "brave-search",
        "openrouter-stats"
      ]
    },
    "code": {
      "execution": {
        "enabled": true,
        "sandbox": true
      },
      "linter": true,
      "formatter": true
    },
    "search": {
      "web": true,
      "local": true,
      "hybrid": true
    },
    "memory": {
      "enabled": true,
      "persistence": true,
      "embeddingModel": "nomic-embed-text",
      "ragEnabled": true
    }
  },
  "workflow": {
    "autoSave": true,
    "checkpoints": true,
    "parallelExecution": true,
    "subAgents": {
      "enabled": true,
      "maxConcurrent": 4
    }
  },
  "logging": {
    "level": "INFO",
    "file": "~/.hermes/logs/hermes.log",
    "rotation": "daily",
    "maxFiles": 7
  }
}
