{
  "name": "Hermes Agent",
  "version": "1.0.0",
  "description": "Universal AI Agent Orchestrator with OpenRouter and Local Model Support",
  "mode": "universal",
  "orchestration": {
    "enabled": true,
    "agents": [
      {
        "id": "openclaw-bridge",
        "name": "OpenClaw Bridge",
        "type": "bridge",
        "endpoint": "http://localhost:18789",
        "enabled": true,
        "priority": 1
      },
      {
        "id": "pi-agent",
        "name": "Pi Coding Agent",
        "type": "pi",
        "endpoint": "http://localhost:31415",
        "enabled": true,
        "priority": 2
      },
      {
        "id": ".claude",
        "name": "Claude Code Agent",
        "type": "claude",
        "enabled": true,
        "priority": 3
      },
      {
        "id": "local-ollama",
        "name": "Local Ollama Models",
        "type": "ollama",
        "endpoint": "http://localhost:11434",
        "enabled": true,
        "priority": 0
      }
    ],
    "routing": {
      "strategy": "cost-optimized",
      "fallback": true,
      "loadBalancing": "round-robin"
    }
  },
  "models": {
    "openrouter": {
      "enabled": true,
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKey": "${OPENROUTER_API_KEY}",
      "freeModels": [
        {
          "id": "google/gemma-4-26b-a4b-it:free",
          "name": "Gemma 4 26B A4B IT",
