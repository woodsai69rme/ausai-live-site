!/ComfyUI/tools/setup_holo31.bat
!/ComfyUI/tools/setup_holo31.py
!/ComfyUI/tools/update_comfyui_tools.bat

# Operator-useful subtrees (CLAUDE.md-referenced subdirs — re-include whole subtree
# via negation; contents visible unless explicitly excluded below)
!/ComfyUI/workflow_templates/
!/ComfyUI/docs/

# === Cont.17-fup-7 follow-up: blanket-ignore ComfyUI/config/ scratch files === 7 files
# at level-1 of ComfyUI/config/ surface as untracked every git status:
# ALL_FREE_MODELS_COMPLETE.md, COMPLETE_SYSTEM_STATE.md,
# OPENROUTER_ALL_FREE_MODELS.txt, SESSION_SUMMARY_Jul8.md,
# free_models_all.md, free_models_setup.md, music_video_studio_config.json.
# Per the cont.17-fup-3 carve-out consensus (deny-sublists-before-re-include-files
# via "last matching pattern wins"), these scratch + operator-runtime files get
# blanket-denied here, then the ONE tracked file re-included via ! rule below.
# (complementar to the existing !/ComfyUI/config/ which re-includes the subtree.)
/ComfyUI/config/*
!/ComfyUI/config/openrouter_free_models.txt
# Pass-15b: Files that churn on every test / monitor run (added 2026-07-14)
# These are local operational logs, not source; git status churn only.
TODO_TRACKER.md
SLEEP_TRIPLE/SLEEP_TRIPLE_AUDIT.jsonl

# Pass-16: Terminal session logs (added 2026-07-13)
# terminals/ contains CLI session capture files — two exceed 40MB each (239.txt=55MB, 249.txt=43MB).
# These are runtime artifacts, not source code. Preserved on disk per Golden Rule #1; just not committed.
# No leading slash (matches anywhere in tree, same convention as tmp/ above).
terminals/

# Pass-16: Grok CLI tool (added 2026-07-13)
# .grok/ contains Grok CLI binary (137MB), session DB, downloads, and docs.
# Selective: preserve .grok/skills/ (referenced by CLAUDE.md Documentation Contract).
# Pattern: deny everything, then re-include skills/ subtree.
.grok/*
!.grok/skills/
!.grok/docs/

*.html.bak

# Pass-17: Noisy untracked directories and root-level master docs (added 2026-07-27)
# These directories churn with generated/archive/helper content. If a file inside
# should be committed, use `git add -f <path>` to force-add it.
# Note: AI_AGENCY/ is a currently-untracked project subdir; force-add if it ever
# graduates to tracked source-of-truth. AI_INFLUENCER_STUDIO/ graduated to tracked
# source on 2026-08-19; its caches stay ignored via the Pass-18 deny-sublists below.
_DOCS_ARCHIVE/
TOOLS/
REVENUE_GENERATORS/
AI_AGENCY/
BACKUPS/
BROWSER_COMPUTER_USE_RESEARCH/
COMPLETED_PROJECTS/mobile_backup/

# Pass-18: AI_INFLUENCER_STUDIO cache deny-sublists (added 2026-08-19)
# The studio graduated to tracked source. Keep only its generated caches ignored
# (deny-sublists, not a top-level deny) so source files stay trackable. build/,
# dist/, __pycache__/, and .pytest_cache/ are already covered by global patterns.
AI_INFLUENCER_STUDIO/.mypy_cache/
AI_INFLUENCER_STUDIO/.ruff_cache/

# Root-level master docs / config fragments generated by indexing tools.
# Pattern ignores keep git status quiet; force-add if a file is source-of-truth.
*_INDEX.md
*_MASTER.md
*_SYSTEM_INDEX.md
ALL_*.md
*_INVENTORY.md

